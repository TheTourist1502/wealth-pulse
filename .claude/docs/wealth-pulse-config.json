  "eventBus": {
    "system": "Custom EventBus Pattern",
    "location": "packages/shared/src/eventBus.ts",
    "events": {
      "authentication": {
        "user:login": {
          "payload": "{ user: User, token: string }",
          "listeners": ["All modules - update auth state"]
        },
        "user:logout": {
          "payload": "{}",
          "listeners": ["All modules - clear state and cache"]
        },
        "user:profile:updated": {
          "payload": "{ user: User }",
          "listeners": ["Header, Settings"]
        }
      },
      "stock": {
        "stock:selected": {
          "payload": "{ symbol: string, data: Stock }",
          "emitter": "Watchlist module",
          "listeners": ["Stock detail page, Price chart"]
        },
        "stock:price:updated": {
          "payload": "{ symbol: string, price: number, change: number }",
          "emitter": "WebSocket listener",
          "listeners": ["Dashboard, Watchlist, Portfolio"]
        },
        "stock:added:watchlist": {
          "payload": "{ symbol: string }",
          "emitter": "Watchlist module",
          "listeners": ["Notifications, Analytics"]
        }
      },
      "portfolio": {
        "portfolio:changed": {
          "payload": "{ portfolioId: string, holdings: Holding[] }",
          "emitter": "Portfolio module",
          "listeners": ["Dashboard, Analytics"]
        },
        "portfolio:created": {
          "payload": "{ portfolio: Portfolio }",
          "emitter": "Portfolio module",
          "listeners": ["Watchlist, Alerts"]
        },
        "holding:added": {
          "payload": "{ holding: Holding }",
          "emitter": "Portfolio module",
          "listeners": ["Dashboard, Performance"]
        }
      },
      "alerts": {
        "alert:triggered": {
          "payload": "{ alert: Alert, value: number }",
          "emitter": "Backend WebSocket",
          "listeners": ["Alerts module, Notification center"]
        },
        "alert:created": {
          "payload": "{ alert: Alert }",
          "emitter": "Alerts module",
          "listeners": ["Notifications"]
        },
        "alert:deleted": {
          "payload": "{ alertId: string }",
          "emitter": "Alerts module",
          "listeners": ["Notifications"]
        }
      },
      "ui": {
        "sidebar:toggled": {
          "payload": "{ open: boolean }",
          "emitter": "Header component",
          "listeners": ["All modules - adjust layout"]
        },
        "theme:changed": {
          "payload": "{ theme: 'light' | 'dark' }",
          "emitter": "Theme selector",
          "listeners": ["All components - update colors"]
        },
        "notification:show": {
          "payload": "{ type: 'success'|'error'|'info', message: string }",
          "emitter": "Any module",
          "listeners": ["Toast notification component"]
        }
      }
    }
  },

  "dataFlow": {
    "userAuthentication": {
      "sequence": [
        "1. User enters credentials on LoginPage",
        "2. useMutation (login) sends to /api/auth/login",
        "3. Backend validates and returns JWT token",
        "4. Token stored in httpOnly cookie",
        "5. Emit user:login event via EventBus",
        "6. authStore updates with user data",
        "7. Redirect to /dashboard"
      ]
    },
    "realTimeStockUpdate": {
      "sequence": [
        "1. Dashboard, Portfolio, Watchlist modules mount",
        "2. useWebSocket hook connects to WS server",
        "3. Subscribe to stock price updates",
        "4. Backend sends price:updated event",
        "5. Emit stock:price:updated via EventBus",
        "6. React Query invalidates cache automatically",
        "7. Components re-render with new prices"
      ]
    },
    "crossModuleCommunication": {
      "sequence": [
        "1. User clicks stock in Watchlist module",
        "2. Watchlist emits stock:selected event",
        "3. Stock detail component (in same or different module) listens",
        "4. Fetch stock data via useStocks hook",
        "5. Display stock details with real-time updates"
      ]
    }
  },

