{
  "app": {
    "name": "WealthPulse",
    "version": "1.0.0",
    "description": "Real-time Financial Dashboard with Micro Frontend Architecture",
    "environment": "development",
    "baseUrl": "http://localhost:3000"
  },

  "architecture": {
    "pattern": "Micro Frontend (MFE) with Module Federation",
    "framework": {
      "react": "18.3.1",
      "typescript": "5.3.3",
      "router": "@tanstack/react-router@1.16.0",
      "stateManagement": "zustand@4.4.7",
      "dataFetching": "@tanstack/react-query@5.28.0",
      "tableManagement": "@tanstack/react-table@8.11.0"
    },
    "buildTool": "webpack@5.89.0",
    "moduleLoader": "@module-federation/enhanced@0.0.10",
    "packageManager": "pnpm@9.0.0",
    "workspaceType": "monorepo",
    "apps": {
      "shell": {
        "port": 3000,
        "type": "container",
        "description": "Main application shell and orchestrator",
        "remotes": {
          "dashboard": "http://localhost:3001/remoteEntry.js",
          "portfolio": "http://localhost:3002/remoteEntry.js",
          "watchlist": "http://localhost:3003/remoteEntry.js",
          "alerts": "http://localhost:3004/remoteEntry.js",
          "shared": "http://localhost:3008/remoteEntry.js"
        },
        "shared": {
          "react": { "singleton": true, "eager": true, "requiredVersion": "^18.0.0" },
          "react-dom": { "singleton": true, "eager": true, "requiredVersion": "^18.0.0" },
          "@tanstack/react-query": { "singleton": true, "requiredVersion": "^5.0.0" },
          "@tanstack/react-router": { "singleton": true, "requiredVersion": "^1.0.0" },
          "@tanstack/react-table": { "singleton": true, "requiredVersion": "^8.0.0" },
          "zustand": { "singleton": true, "requiredVersion": "^4.0.0" }
        }
      },
      "dashboard": {
        "port": 3001,
        "type": "feature-module",
        "description": "Dashboard and portfolio overview module",
        "exposes": {
          "./Dashboard": "./src/Dashboard.tsx",
          "./routes": "./src/routes.ts"
        }
      },
      "portfolio": {
        "port": 3002,
        "type": "feature-module",
        "description": "Portfolio management and analytics module",
        "exposes": {
          "./Portfolio": "./src/Portfolio.tsx",
          "./routes": "./src/routes.ts"
        }
      },
      "watchlist": {
        "port": 3003,
        "type": "feature-module",
        "description": "Stock watchlist and monitoring module",
        "exposes": {
          "./Watchlist": "./src/Watchlist.tsx",
          "./routes": "./src/routes.ts"
        }
      },
      "alerts": {
        "port": 3004,
        "type": "feature-module",
        "description": "Alerts and notifications module",
        "exposes": {
          "./Alerts": "./src/Alerts.tsx",
          "./routes": "./src/routes.ts"
        }
      },
      "shared": {
        "port": 3008,
        "type": "shared-library",
        "description": "Shared utilities, types, hooks, and components",
        "exposes": {
          "./types": "./src/types/index.ts",
          "./api": "./src/api/index.ts",
          "./hooks": "./src/hooks/index.ts",
          "./components": "./src/components/index.ts",
          "./utils": "./src/utils/index.ts",
          "./stores": "./src/stores/index.ts",
          "./eventBus": "./src/eventBus.ts"
        }
      }
    }
  },

  "rules": {
    "architecture": {
      "moduleFederation": {
        "rule_001": "Each feature module must expose components via Module Federation",
        "rule_002": "Shared module is singleton - loaded once and shared across all modules",
        "rule_003": "No direct imports between feature modules - use EventBus for communication",
        "rule_004": "All API calls must go through shared/api hooks",
        "rule_005": "Feature modules can only be lazy-loaded via React.lazy() + Suspense",
        "rule_006": "Cross-module state syncing via Zustand + EventBus only",
        "rule_007": "Each module must have its own TypeScript config with shared base",
        "rule_008": "Module entry points must export default component and routes"
      },
      "naming": {
        "rule_101": "Apps in apps/ folder (shell, dashboard, portfolio, watchlist, alerts)",
        "rule_102": "Shared code in packages/shared",
        "rule_103": "Each module: src/[components|hooks|pages|types|utils]",
        "rule_104": "Component names: PascalCase (e.g., PortfolioSummary.tsx)",
        "rule_105": "Hook names: camelCase with 'use' prefix (e.g., usePortfolioData.ts)",
        "rule_106": "Type files: index.ts as barrel exports",
        "rule_107": "API files: queries.ts for read ops, mutations.ts for write ops",
        "rule_108": "Store files: [featureName]Store.ts (e.g., authStore.ts)"
      },
      "dependencies": {
        "rule_201": "React and peer dependencies must be peerDependencies in feature modules",
        "rule_202": "DevDependencies only for build tools (webpack, typescript, etc.)",
        "rule_203": "No circular dependencies allowed (ESLint rule enforced)",
        "rule_204": "External libraries: only approved list (recharts, axios, clsx, etc.)",
        "rule_205": "Monorepo packages referenced as @wealth-pulse/[package-name]",
        "rule_206": "Version mismatch tolerance: minor versions only (^X.Y.Z)",
        "rule_207": "Security updates applied within 48 hours of release"
      }
    },
    "codeQuality": {
      "typescript": {
        "rule_301": "Strict mode enabled globally - strictNullChecks: true",
        "rule_302": "noImplicitAny: true - all types must be explicit",
        "rule_303": "noUnusedLocals: true - no dead code",
        "rule_304": "noUnusedParameters: true - all params must be used",
        "rule_305": "esModuleInterop: true for CommonJS compatibility",
        "rule_306": "resolveJsonModule: true for JSON imports",
        "rule_307": "skipLibCheck: true - faster builds",
        "rule_308": "Target: ES2020 minimum"
      },
      "linting": {
        "rule_401": "ESLint enforced on all TypeScript files",
        "rule_402": "Prettier formatting on save (2 space indent)",
        "rule_403": "No console logs in production builds (eslint-plugin-no-console)",
        "rule_404": "React best practices enforced (eslint-plugin-react-hooks)",
        "rule_405": "Imports must be sorted and organized",
        "rule_406": "Max line length: 100 characters",
        "rule_407": "No unused imports allowed",
        "rule_408": "A11y rules enforced (eslint-plugin-jsx-a11y)"
      },
      "testing": {
        "rule_501": "Minimum 80% code coverage required",
        "rule_502": "All utils functions must have unit tests",
        "rule_503": "All custom hooks must have hook tests",
        "rule_504": "All components must have integration tests",
        "rule_505": "E2E tests for critical user flows",
        "rule_506": "Tests run on every commit (pre-commit hook)",
        "rule_507": "Coverage reports generated on each build",
        "rule_508": "Snapshot tests for visual regression detection"
      }
    },
    "performance": {
      "bundling": {
        "rule_601": "Code splitting by route (automatic with TanStack Router)",
        "rule_602": "Lazy load feature modules (async import via Module Federation)",
        "rule_603": "Tree-shake unused code in production",
        "rule_604": "Minify and compress all assets",
        "rule_605": "Bundle size monitoring: alert if > 500KB (gzipped)",
        "rule_606": "Chunk size limits: entry 200KB, async 150KB (gzipped)",
        "rule_607": "Source maps only in development"
      },
      "runtime": {
        "rule_701": "React Query stale times: 5 min (portfolio), 1 min (prices)",
        "rule_702": "Cache invalidation on mutation",
        "rule_703": "Optimize re-renders with useMemo/useCallback",
        "rule_704": "Virtual scrolling for large lists (100+ items)",
        "rule_705": "Pagination default: 20 items per page",
        "rule_706": "Debounce search inputs (300ms)",
        "rule_707": "Throttle window resize listeners (200ms)"
      },
      "network": {
        "rule_801": "API request timeout: 30 seconds",
        "rule_802": "Retry logic: 3 attempts with exponential backoff",
        "rule_803": "Request batching for multiple API calls",
        "rule_804": "Gzip compression on all responses",
        "rule_805": "CORS enabled for localhost development",
        "rule_806": "Rate limiting: 60 requests/minute per endpoint",
        "rule_807": "WebSocket reconnection attempts: 5 with backoff"
      }
    },
    "security": {
      "authentication": {
        "rule_901": "JWT tokens stored in httpOnly cookies only",
        "rule_902": "Token refresh before expiry (5 min buffer)",
        "rule_903": "Logout clears all stored tokens and state",
        "rule_904": "CSRF protection: x-csrf-token header on mutations",
        "rule_905": "Credentials sent in all cross-origin requests"
      },
      "sanitization": {
        "rule_1001": "All user input sanitized before display",
        "rule_1002": "No dangerouslySetInnerHTML without review",
        "rule_1003": "XSS protection via Content Security Policy",
        "rule_1004": "SQL injection prevention via parameterized queries (backend)",
        "rule_1005": "DOMPurify used for HTML sanitization"
      },
      "dataProtection": {
        "rule_1101": "Sensitive data (passwords) never logged",
        "rule_1102": "API keys stored in environment variables only",
        "rule_1103": "HTTPS/TLS for all communications",
        "rule_1104": "Data encryption at rest (backend responsibility)",
        "rule_1105": "PII masked in logs (emails, phone numbers)"
      }
    }
  },

  "styling": {
    "system": "Tailwind CSS",
    "version": "3.4.1",
    "configuration": {
      "spacing": "4px base unit",
      "breakpoints": {
        "xs": "320px",
        "sm": "640px",
        "md": "768px",
        "lg": "1024px",
        "xl": "1280px",
        "2xl": "1536px"
      },
      "colors": {
        "primary": "hsl(var(--color-primary) / <alpha-value>)",
        "secondary": "hsl(var(--color-secondary) / <alpha-value>)",
        "accent": "hsl(var(--color-accent) / <alpha-value>)",
        "success": "hsl(var(--color-success) / <alpha-value>)",
        "warning": "hsl(var(--color-warning) / <alpha-value>)",
        "error": "hsl(var(--color-error) / <alpha-value>)",
        "neutral": "hsl(var(--color-neutral) / <alpha-value>)"
      },
      "typography": {
        "fontFamily": {
          "sans": "Inter, system-ui, sans-serif",
          "mono": "Fira Code, monospace"
        },
        "fontSize": {
          "xs": "0.75rem",
          "sm": "0.875rem",
          "base": "1rem",
          "lg": "1.125rem",
          "xl": "1.25rem",
          "2xl": "1.5rem",
          "3xl": "1.875rem",
          "4xl": "2.25rem"
        },
        "fontWeight": {
          "light": 300,
          "normal": 400,
          "medium": 500,
          "semibold": 600,
          "bold": 700
        }
      },
      "shadows": {
        "xs": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
        "sm": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
        "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
        "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
        "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1)"
      },
      "borderRadius": {
        "none": "0",
        "sm": "0.125rem",
        "md": "0.375rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "2xl": "1rem"
      }
    },
    "rules": {
      "styling_001": "Use Tailwind classes only - no inline CSS",
      "styling_002": "Custom CSS in CSS modules only (rarely needed)",
      "styling_003": "Use CSS variables for theme colors: var(--color-primary)",
      "styling_004": "Component classes: use clsx for conditional styling",
      "styling_005": "No hardcoded colors - use theme tokens",
      "styling_006": "Responsive design mobile-first (sm: before lg:)",
      "styling_007": "All interactive elements: hover/focus states",
      "styling_008": "Spacing: use Tailwind units (p-4, m-2, gap-3, etc.)",
      "styling_009": "Animations: use Tailwind @apply or CSS modules",
      "styling_010": "Dark mode support via dark: prefix everywhere"
    },
    "components": {
      "button": {
        "variants": ["primary", "secondary", "danger", "ghost"],
        "sizes": ["xs", "sm", "md", "lg", "xl"],
        "states": ["default", "hover", "active", "disabled", "loading"],
        "example": "bg-primary hover:bg-primary-600 disabled:opacity-50"
      },
      "input": {
        "variants": ["text", "email", "password", "number", "search"],
        "sizes": ["sm", "md", "lg"],
        "states": ["default", "focus", "error", "disabled"],
        "example": "border border-neutral-300 focus:ring-2 focus:ring-primary"
      },
      "card": {
        "variants": ["default", "elevated", "outlined"],
        "example": "rounded-lg border border-neutral-200 bg-white p-4 shadow-md"
      },
      "badge": {
        "variants": ["success", "warning", "error", "info"],
        "sizes": ["sm", "md"],
        "example": "inline-flex items-center rounded-full bg-success-100 px-3 py-1 text-sm text-success-700"
      },
      "alert": {
        "variants": ["success", "warning", "error", "info"],
        "example": "rounded-lg bg-error-50 border border-error-300 p-4 text-error-700"
      }
    }
  },

  "theming": {
    "system": "CSS Variables + Tailwind",
    "mode": "light",
    "modes": ["light", "dark", "system"],
    "implementation": {
      "lightTheme": {
        "colorPrimary": "210 100% 50%",
        "colorSecondary": "280 85% 55%",
        "colorAccent": "35 100% 50%",
        "colorSuccess": "142 71% 45%",
        "colorWarning": "38 92% 50%",
        "colorError": "0 84% 60%",
        "colorNeutral": "0 0% 50%",
        "bgPrimary": "0 0% 100%",
        "bgSecondary": "0 0% 97%",
        "bgTertiary": "0 0% 94%",
        "textPrimary": "0 0% 8%",
        "textSecondary": "0 0% 35%",
        "textTertiary": "0 0% 55%",
        "borderPrimary": "0 0% 90%",
        "borderSecondary": "0 0% 85%"
      },
      "darkTheme": {
        "colorPrimary": "210 100% 60%",
        "colorSecondary": "280 85% 65%",
        "colorAccent": "35 100% 60%",
        "colorSuccess": "142 71% 55%",
        "colorWarning": "38 92% 60%",
        "colorError": "0 84% 70%",
        "colorNeutral": "0 0% 50%",
        "bgPrimary": "0 0% 12%",
        "bgSecondary": "0 0% 18%",
        "bgTertiary": "0 0% 24%",
        "textPrimary": "0 0% 98%",
        "textSecondary": "0 0% 80%",
        "textTertiary": "0 0% 60%",
        "borderPrimary": "0 0% 30%",
        "borderSecondary": "0 0% 25%"
      }
    },
    "cssVariables": {
      "location": "packages/shared/src/styles/variables.css",
      "format": ":root { --color-primary: 210 100% 50%; }",
      "priority": "High - loaded first in HTML head"
    },
    "rules": {
      "theming_001": "Theme colors via CSS variables only",
      "theming_002": "Dark mode toggle persisted in localStorage",
      "theming_003": "System preference detection on first load",
      "theming_004": "Smooth transition between themes (0.3s)",
      "theming_005": "All components support both light and dark modes",
      "theming_006": "High contrast mode for accessibility (WCAG AA)",
      "theming_007": "Brand colors updated in shared package only",
      "theming_008": "Color tokens documented in design system"
    }
  },

  "routing": {
    "system": "@tanstack/react-router",
    "version": "1.16.0",
    "structure": "File-based with TanStack Router",
    "rootLayout": "apps/shell/src/layouts/RootLayout.tsx",
    "routes": {
      "public": {
        "/": {
          "name": "home",
          "component": "Dashboard (lazy from dashboard module)",
          "path": "apps/dashboard/src/Dashboard.tsx",
          "layout": "RootLayout",
          "permissions": "none",
          "meta": {
            "title": "Dashboard",
            "description": "Financial dashboard overview"
          }
        },
        "/auth/login": {
          "name": "login",
          "component": "LoginPage",
          "path": "apps/shell/src/pages/LoginPage.tsx",
          "layout": "BlankLayout",
          "permissions": "unauthenticated",
          "meta": {
            "title": "Login - WealthPulse",
            "description": "Sign in to your account"
          }
        },
        "/auth/signup": {
          "name": "signup",
          "component": "SignupPage",
          "path": "apps/shell/src/pages/SignupPage.tsx",
          "layout": "BlankLayout",
          "permissions": "unauthenticated",
          "meta": {
            "title": "Sign Up - WealthPulse",
            "description": "Create a new account"
          }
        },
        "/auth/forgot-password": {
          "name": "forgotPassword",
          "component": "ForgotPasswordPage",
          "path": "apps/shell/src/pages/ForgotPasswordPage.tsx",
          "layout": "BlankLayout",
          "permissions": "unauthenticated",
          "meta": {
            "title": "Forgot Password",
            "description": "Reset your password"
          }
        }
      },
      "protected": {
        "/dashboard": {
          "name": "dashboard",
          "component": "Dashboard (lazy from dashboard module)",
          "module": "dashboard",
          "port": 3001,
          "path": "apps/dashboard/src/Dashboard.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "meta": {
            "title": "Dashboard - WealthPulse",
            "description": "Your financial dashboard"
          }
        },
        "/portfolio": {
          "name": "portfolio",
          "component": "Portfolio (lazy from portfolio module)",
          "module": "portfolio",
          "port": 3002,
          "path": "apps/portfolio/src/Portfolio.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "meta": {
            "title": "Portfolio - WealthPulse",
            "description": "Manage your investment portfolio"
          }
        },
        "/portfolio/:id": {
          "name": "portfolioDetail",
          "component": "PortfolioDetail",
          "path": "apps/portfolio/src/pages/PortfolioDetail.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "params": {
            "id": "string (portfolio UUID)"
          },
          "meta": {
            "title": "Portfolio Details",
            "description": "View portfolio details"
          }
        },
        "/watchlist": {
          "name": "watchlist",
          "component": "Watchlist (lazy from watchlist module)",
          "module": "watchlist",
          "port": 3003,
          "path": "apps/watchlist/src/Watchlist.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "meta": {
            "title": "Watchlist - WealthPulse",
            "description": "Monitor your watched stocks"
          }
        },
        "/watchlist/:symbol": {
          "name": "stockDetail",
          "component": "StockDetail",
          "path": "apps/watchlist/src/pages/StockDetail.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "params": {
            "symbol": "string (stock symbol)"
          },
          "meta": {
            "title": "Stock Details",
            "description": "View detailed stock information"
          }
        },
        "/alerts": {
          "name": "alerts",
          "component": "Alerts (lazy from alerts module)",
          "module": "alerts",
          "port": 3004,
          "path": "apps/alerts/src/Alerts.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "meta": {
            "title": "Alerts - WealthPulse",
            "description": "Manage your price and portfolio alerts"
          }
        },
        "/settings": {
          "name": "settings",
          "component": "Settings",
          "path": "apps/shell/src/pages/Settings.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "meta": {
            "title": "Settings - WealthPulse",
            "description": "Manage your account settings"
          }
        },
        "/settings/profile": {
          "name": "profileSettings",
          "component": "ProfileSettings",
          "path": "apps/shell/src/pages/ProfileSettings.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "meta": {
            "title": "Profile Settings",
            "description": "Update your profile"
          }
        },
        "/settings/security": {
          "name": "securitySettings",
          "component": "SecuritySettings",
          "path": "apps/shell/src/pages/SecuritySettings.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "meta": {
            "title": "Security Settings",
            "description": "Manage security and authentication"
          }
        },
        "/settings/notifications": {
          "name": "notificationSettings",
          "component": "NotificationSettings",
          "path": "apps/shell/src/pages/NotificationSettings.tsx",
          "layout": "RootLayout",
          "permissions": "authenticated",
          "meta": {
            "title": "Notification Settings",
            "description": "Manage notification preferences"
          }
        }
      },
      "error": {
        "/404": {
          "name": "notFound",
          "component": "NotFoundPage",
          "path": "apps/shell/src/pages/NotFoundPage.tsx",
          "layout": "BlankLayout",
          "meta": {
            "title": "Page Not Found",
            "description": "The page you're looking for doesn't exist"
          }
        },
        "/500": {
          "name": "serverError",
          "component": "ErrorPage",
          "path": "apps/shell/src/pages/ErrorPage.tsx",
          "layout": "BlankLayout",
          "meta": {
            "title": "Server Error",
            "description": "Something went wrong"
          }
        }
      }
    },
    "rules": {
      "routing_001": "All routes defined in apps/shell/src/router.ts",
      "routing_002": "Feature module routes lazy-loaded via React.lazy()",
      "routing_003": "Route parameters must be typed: /dashboard/:id (id: string)",
      "routing_004": "Query parameters handled via useSearch hook",
      "routing_005": "Route protection via useAuth middleware",
      "routing_006": "Deep linking supported - all routes shareable",
      "routing_007": "Back button works correctly (history managed by Router)",
      "routing_008": "404 route is catch-all for undefined routes",
      "routing_009": "Prefetch data before navigation when possible",
      "routing_010": "Analytics tracking on every route change"
    },
    "navigation": {
      "sidebarMenu": {
        "location": "apps/shell/src/components/Sidebar.tsx",
        "items": [
          {
            "label": "Dashboard",
            "icon": "LayoutDashboard",
            "route": "/dashboard",
            "permissions": "authenticated"
          },
          {
            "label": "Portfolio",
            "icon": "Briefcase",
            "route": "/portfolio",
            "permissions": "authenticated",
            "children": [
              {
                "label": "Overview",
                "route": "/portfolio"
              },
              {
                "label": "Holdings",
                "route": "/portfolio?tab=holdings"
              },
              {
                "label": "Performance",
                "route": "/portfolio?tab=performance"
              }
            ]
          },
          {
            "label": "Watchlist",
            "icon": "Star",
            "route": "/watchlist",
            "permissions": "authenticated"
          },
          {
            "label": "Alerts",
            "icon": "Bell",
            "route": "/alerts",
            "permissions": "authenticated",
            "badge": "unreadCount"
          },
          {
            "label": "Settings",
            "icon": "Settings",
            "route": "/settings",
            "permissions": "authenticated"
          }
        ]
      },
      "headerNavigation": {
        "location": "apps/shell/src/components/Header.tsx",
        "items": [
          {
            "type": "search",
            "placeholder": "Search stocks, portfolios...",
            "action": "global search"
          },
          {
            "type": "notifications",
            "icon": "Bell",
            "action": "open notifications"
          },
          {
            "type": "user-menu",
            "icon": "User",
            "items": [
              { "label": "Profile", "route": "/settings/profile" },
              { "label": "Settings", "route": "/settings" },
              { "divider": true },
              { "label": "Logout", "action": "logout" }
            ]
          }
        ]
      }
    },
    "middleware": {
      "authMiddleware": {
        "location": "packages/shared/src/middleware/authMiddleware.ts",
        "protects": "All /dashboard, /portfolio, /watchlist, /alerts routes",
