  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "headroom init hook ensure",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "headroom init hook ensure",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,os,re,sys; fp=json.loads(os.environ.get('CLAUDE_TOOL_INPUT','{}') or '{}').get('file_path',''); b=os.path.basename(fp); (re.fullmatch(r'\\.env(\\..+)?', b) and b!='.env.example') and (print(f'Blocked: {fp} holds secrets — use .env.example for keys'), sys.exit(2))\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,os,re,sys; cmd=json.loads(os.environ.get('CLAUDE_TOOL_INPUT','{}') or '{}').get('command',''); re.search(r'\\.env(?!\\.example)(\\.[\\w-]+)?(\\s|$|[\\'\\\\\\\";|])', cmd) and (print('Blocked: command touches a .env secrets file'), sys.exit(2))\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,os,subprocess; fp=json.loads(os.environ.get('CLAUDE_TOOL_INPUT','{}') or '{}').get('file_path',''); fp.endswith(('.ts','.tsx','.css','.json')) and os.path.exists('package.json') and subprocess.run(['pnpm','exec','prettier','--write',fp])\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f package.json ] && pnpm -s type-check 2>&1 | tail -20 || true"
          }
        ]
      }
    ]
  },
